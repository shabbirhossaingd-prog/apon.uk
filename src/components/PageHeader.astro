---
import '../styles/subpages.css';

const { eyebrow = 'Apon UK', title, subtitle = '', actions = [] } = Astro.props;
const key = String(title || '').toLowerCase();
const images = {
  study: 'https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1200&q=82',
  research: 'https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=1200&q=82',
  job: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1200&q=82',
  startup: 'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1200&q=82',
  freelance: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1200&q=82',
  guidance: 'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=82',
  scholarship: 'https://images.unsplash.com/photo-1523580846011-d3a5bc25702b?auto=format&fit=crop&w=1200&q=82',
  finance: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=1200&q=82',
  team: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=82',
  contact: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=1200&q=82',
  tech: 'https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1200&q=82'
};
let heroImage = images.study;
if (key.includes('research')) heroImage = images.research;
else if (key.includes('job')) heroImage = images.job;
else if (key.includes('startup')) heroImage = images.startup;
else if (key.includes('freelanc')) heroImage = images.freelance;
else if (key.includes('guid') || key.includes('training') || key.includes('seminar')) heroImage = images.guidance;
else if (key.includes('scholar')) heroImage = images.scholarship;
else if (key.includes('financial') || key.includes('payment')) heroImage = images.finance;
else if (key.includes('about') || key.includes('pioneer') || key.includes('ambassador') || key.includes('work with')) heroImage = images.team;
else if (key.includes('contact') || key.includes('help')) heroImage = images.contact;
else if (key.includes('app') || key.includes('sector') || key.includes('government') || key.includes('opportunit')) heroImage = images.tech;
---
<section class="content-hero subpage-hero">
  <div class="container subpage-hero-grid">
    <div class="subpage-hero-copy">
      <span class="eyebrow"><span class="eyebrow-dot"></span>{eyebrow}</span>
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
      {actions?.length > 0 && <div class="hero-actions">{actions.map((action) => <a class={`btn ${action.primary ? 'btn-primary' : 'btn-secondary'}`} href={action.href}>{action.label}</a>)}</div>}
    </div>
    <div class="subpage-hero-media" aria-hidden="true">
      <img src={heroImage} alt="" width="900" height="720" loading="eager" fetchpriority="high" decoding="async" />
      <span class="media-wash"></span>
      <span class="media-ring media-ring-one"></span>
      <span class="media-ring media-ring-two"></span>
      <span class="media-brand">A</span>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('#main-content');
    if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const targets = root.querySelectorAll('.prose > section, .prose > p, .prose > ul, .prose > ol, .content-card, .info-panel, .archive-card, .form-card, .app-panel');
    targets.forEach((el, index) => {
      el.classList.add('reveal-item');
      el.style.setProperty('--reveal-delay', `${Math.min(index * 55, 275)}ms`);
    });
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px' });
    targets.forEach((el) => observer.observe(el));
  })();
</script>
