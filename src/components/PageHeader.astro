---
import '../styles/subpages.css';

const { eyebrow = 'Apon UK', title, subtitle = '', actions = [] } = Astro.props;
const key = String(title || '').toLowerCase();
const images = {
  study: 'https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fm=webp&fit=crop&w=1200&q=78',
  research: 'https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fm=webp&fit=crop&w=1200&q=78',
  job: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fm=webp&fit=crop&w=1200&q=78',
  startup: 'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fm=webp&fit=crop&w=1200&q=78',
  freelance: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fm=webp&fit=crop&w=1200&q=78',
  guidance: 'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fm=webp&fit=crop&w=1200&q=78',
  scholarship: 'https://images.unsplash.com/photo-1523580846011-d3a5bc25702b?auto=format&fm=webp&fit=crop&w=1200&q=78',
  finance: 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fm=webp&fit=crop&w=1200&q=78',
  team: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fm=webp&fit=crop&w=1200&q=78',
  contact: 'https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fm=webp&fit=crop&w=1200&q=78',
  tech: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fm=webp&fit=crop&w=1200&q=78'
};
let heroImage = images.study;
if (key.includes('research')) heroImage = images.research;
else if (key.includes('job')) heroImage = images.job;
else if (key.includes('startup')) heroImage = images.startup;
else if (key.includes('freelanc')) heroImage = images.freelance;
else if (key.includes('guid') || key.includes('training') || key.includes('seminar')) heroImage = images.guidance;
else if (key.includes('scholar')) heroImage = images.scholarship;
else if (key.includes('financial') || key.includes('payment')) heroImage = images.finance;
else if (key.includes('about') || key.includes('pioneer') || key.includes('ambassador') || key.includes('work with')) heroImage = images.team;
else if (key.includes('contact') || key.includes('help')) heroImage = images.contact;
else if (key.includes('app') || key.includes('sector') || key.includes('government') || key.includes('opportunit')) heroImage = images.tech;
---
<section class="content-hero subpage-hero edu-shared-hero">
  <div class="container subpage-hero-grid">
    <div class="subpage-hero-copy">
      <span class="eyebrow"><span class="eyebrow-dot"></span>{eyebrow}</span>
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
      {actions?.length > 0 && <div class="hero-actions">{actions.map((action) => <a class={`btn ${action.primary ? 'btn-primary' : 'btn-secondary'}`} href={action.href}>{action.label}</a>)}</div>}
    </div>
    <div class="subpage-hero-media" aria-hidden="true">
      <span class="edu-hero-shape edu-hero-shape-a"></span>
      <span class="edu-hero-shape edu-hero-shape-b"></span>
      <img src={heroImage} alt="" width="900" height="720" loading="eager" fetchpriority="high" decoding="async" />
    </div>
  </div>
</section>

<style is:global>
.edu-shared-hero{padding:118px 0 68px!important;background:linear-gradient(120deg,#f4f8fd 0%,#eef5fc 58%,#fff4ed 100%)!important;color:#10233f!important;overflow:hidden!important;position:relative!important;isolation:isolate!important}
.edu-shared-hero:before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:radial-gradient(rgba(21,87,183,.09) .75px,transparent .75px),radial-gradient(circle at 86% 18%,rgba(255,130,61,.11),transparent 20%);background-size:24px 24px,auto;opacity:.55;mask-image:linear-gradient(90deg,transparent,black 16%,black 88%,transparent)}
.edu-shared-hero .subpage-hero-grid{grid-template-columns:minmax(0,.9fr) minmax(380px,.72fr)!important;gap:64px!important;min-height:410px!important;align-items:center!important}
.edu-shared-hero .subpage-hero-copy{max-width:720px!important}
.edu-shared-hero .eyebrow{background:#fff!important;color:#1557b7!important;border:1px solid rgba(21,87,183,.1)!important;box-shadow:0 7px 24px rgba(8,43,97,.05)!important}
.edu-shared-hero .eyebrow-dot{background:#ff823d!important}
.edu-shared-hero h1{color:#082b61!important;font-size:clamp(3.25rem,5.45vw,5.9rem)!important;font-weight:670!important;line-height:.92!important;letter-spacing:-.055em!important;margin:22px 0 20px!important;max-width:720px!important}
.edu-shared-hero p{color:#66758a!important;font-size:1rem!important;max-width:590px!important;line-height:1.68!important}
.edu-shared-hero .hero-actions{margin-top:28px!important}
.edu-shared-hero .subpage-hero-media{position:relative!important;height:370px!important;border:0!important;border-radius:28px!important;box-shadow:none!important;overflow:visible!important;transform:none!important;background:transparent!important;isolation:isolate!important}
.edu-shared-hero .subpage-hero-media:before,.edu-shared-hero .subpage-hero-media:after{display:none!important}
.edu-shared-hero .subpage-hero-media img{position:absolute!important;inset:18px 0 0 20px!important;width:calc(100% - 20px)!important;height:calc(100% - 18px)!important;object-fit:cover!important;border-radius:26px!important;box-shadow:0 22px 54px rgba(8,43,97,.12)!important;z-index:2!important}
.edu-shared-hero .edu-hero-shape{position:absolute;display:block;pointer-events:none;z-index:1}
.edu-shared-hero .edu-hero-shape-a{width:108px;height:108px;border-radius:30px;background:#1557b7;right:-18px;top:-16px;transform:rotate(13deg);box-shadow:0 12px 28px rgba(21,87,183,.18)}
.edu-shared-hero .edu-hero-shape-b{width:82px;height:82px;border-radius:50%;background:#ff823d;left:-14px;bottom:-10px;opacity:.92;box-shadow:0 12px 28px rgba(255,130,61,.18)}
@media(max-width:980px){.edu-shared-hero{padding:108px 0 60px!important}.edu-shared-hero .subpage-hero-grid{grid-template-columns:1fr!important;gap:34px!important;min-height:auto!important}.edu-shared-hero .subpage-hero-media{height:330px!important;max-width:680px!important}.edu-shared-hero h1{font-size:clamp(3.1rem,8.8vw,5rem)!important}}
@media(max-width:640px){.edu-shared-hero{padding:100px 0 46px!important}.edu-shared-hero h1{font-size:clamp(2.7rem,13vw,4.1rem)!important}.edu-shared-hero .subpage-hero-media{height:260px!important}.edu-shared-hero .subpage-hero-media img{inset:10px 0 0 10px!important;width:calc(100% - 10px)!important;height:calc(100% - 10px)!important;border-radius:20px!important}.edu-shared-hero .edu-hero-shape-a{width:76px;height:76px;right:-8px}.edu-shared-hero .edu-hero-shape-b{width:62px;height:62px;left:-6px}}
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('#main-content');
    if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const targets = root.querySelectorAll('.prose > section, .prose > p, .prose > ul, .prose > ol, .content-card, .info-panel, .archive-card, .form-card, .app-panel');
    targets.forEach((el, index) => {
      el.classList.add('reveal-item');
      const direction = index % 2 === 0 ? 'reveal-left' : 'reveal-right';
      el.classList.add(direction);
      el.style.setProperty('--motion-delay', `${Math.min(index % 4, 3) * 70}ms`);
    });
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.14, rootMargin: '0px 0px -55px' });
    targets.forEach((el) => observer.observe(el));
  })();
</script>
