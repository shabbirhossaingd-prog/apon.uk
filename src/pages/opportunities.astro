---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Layout title="Opportunities | Apon UK" description="Work opportunities with learning support, freelancing, work experience, interns, global job with remote work.">
  <PageHeader title="Opportunities" subtitle="Work opportunities with learning support. Freelancing, work experience, interns, global job with remote work" actions={[{label:'Apon Portal',href:'https://portal.apon.uk/',primary:true}]} />
  <section class="section white">
    <div class="container info-grid">
      <article class="info-panel"><h2>Work with us</h2><p>University, Private company or individuals.</p><div class="hero-actions"><a class="btn btn-secondary" href="/work-with-us/">Click here for details</a></div></article>
      <article class="info-panel"><h2>Global Experience</h2><p>IT, Digital skills, accounting, content writing……</p><p>Start Learning and earning.</p><p>Part time or Full time work.</p><p>Start your global career journey …</p></article>
    </div>
  </section>
  <section class="section">
    <div class="container cta"><div><h2>Work and earn success with Global experts</h2><p>Work opportunities with learning support<br/>Freelancing, work experience,<br/>interns, global job with remote work</p></div><div class="cta-actions"><a class="btn btn-primary" href="/category/opportunities/">Read More</a></div></div>
  </section>
</Layout>
