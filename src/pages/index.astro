---
import Layout from '../layouts/Layout.astro';
const training = ['English and IELTS','WordPress and SEO','App Development','Freelancing Programme','PhD & Research Training','Cloud Computing','AWS AI/ML certification','Startup Entrepreneur Training','Accounting (ACCA/CA)','Digital Marketing & Social Media Management'];
---
<Layout title="Apon UK: Global Platform with App and AI" description="Career, Asset Management, R&D Consultancy. Study, Freelancing, Job, Startup and Research degree globally.">
  <section class="hero"><div class="container hero-grid"><div><span class="eyebrow"><span class="eyebrow-dot"></span> About Apon UK</span><h1>Making a <em>global career</em></h1><div class="hero-copy"><p><strong>Study, Freelancing, Job, Startup, Research degree globally</strong></p><p>Upload your details, start free training, work with us</p><p>Personal mentoring, forum, development support</p></div><div class="hero-actions"><a class="btn btn-primary" href="https://portal.apon.uk/">Join Apon Career platform free</a><a class="btn btn-secondary" href="/about/">Read More</a></div></div><div class="visual-card" aria-label="Global career visual"><div class="visual-grid"></div><div class="globe"></div><div class="study-card"><span class="mini">Set Goal, Learn & Earn</span><h3>Study, Freelancing, Job, Startup, Research degree globally</h3><div class="study-meta"><span class="chip">Study</span><span class="chip">Job</span><span class="chip">Research</span><span class="chip">Startup</span><span class="chip">Freelancing</span></div></div></div></div></section>

  <section class="section white"><div class="container"><div class="section-head"><div><h2>Set Goal, Learn & Earn</h2></div><p>Goal: Job , Study abroad, start a research degree, startup or freelancing.</p></div><div class="cards"><article class="card"><div class="icon">↗</div><h3>Work and earn success with Global experts</h3><p>Work opportunities with learning support<br/>Freelancing, work experience,<br/>interns, global job with remote work</p><a class="text-link" href="/opportunities/">Read More →</a></article><article class="card"><div class="icon">◎</div><h3>Set Goal, Learn & Earn</h3><p>Goal: Job , Study abroad, start a research degree, startup or freelancing.</p><a class="text-link" href="/success/">Read More →</a></article><article class="card"><div class="icon">▤</div><h3>Guidance Ebook, join seminar</h3><p>Goal? Job , Study abroad, start a research degree, start up or freelancing.</p><a class="text-link" href="/guidance/">Read More →</a></article><article class="card"><div class="icon">✦</div><h3>Free training</h3><p>Training with work experience<br/>Free, personalized with real world example</p><a class="text-link" href="/free-training/">Read More →</a></article><article class="card"><div class="icon">◫</div><h3>Work and earn success with Global experts</h3><p>Work opportunities with learning support<br/>Freelancing, work experience,<br/>interns, global job with remote work</p><a class="text-link" href="/opportunities/">Read More →</a></article><article class="card"><div class="icon">AI</div><h3>Web Portal, AI & App</h3><p>About Apon UK</p><a class="text-link" href="/about/">Click Here →</a></article></div></div></section>

  <section class="section"><div class="container split"><div><span class="eyebrow"><span class="eyebrow-dot"></span> About Apon UK</span><h2 style="font-size:clamp(2.4rem,5vw,4.6rem);margin:18px 0 20px">Apon (someone very close, trustable) is a platform for global success.</h2><p style="color:var(--muted)">20+ years of experience in Europe, far east and America. Follow us.</p><div class="hero-actions"><a class="btn btn-secondary" href="/about/">Click Here</a><a class="btn btn-primary" href="/contact/">Contact us</a></div></div><div class="feature-panel"><span class="eyebrow"><span class="eyebrow-dot"></span> Guideline Seminar</span><ul><li><span class="check">✓</span><span>Seminars on 3 areas: Overview, Global Study, Global Careers and Beyond</span></li><li><span class="check">✓</span><span>Know more about higher study, research, job, scholarship, living expense</span></li><li><span class="check">✓</span><span>For next seminar Register online</span></li></ul></div></div></section>

  <section class="section white"><div class="container"><div class="section-head"><div><h2>Apon UK at a Glance</h2></div></div><div class="stat-strip"><div class="stat"><strong>2014</strong><span>Established</span></div><div class="stat"><strong>5+</strong><span>Countries</span></div><div class="stat"><strong>2+</strong><span>Location</span></div></div><div class="hero-actions"><a class="btn btn-secondary" href="/contact/">Contact us</a><a class="btn btn-primary" href="https://wa.me/447459157276">Join our WhatsApp community</a></div></div></section>

  <section class="section"><div class="container split"><div class="feature-panel"><span class="eyebrow"><span class="eyebrow-dot"></span> Career guidance Ebook</span><ul><li><span class="check">1</span><span>Complete guide to a global career</span></li><li><span class="check">2</span><span>Covers 10 key steps, planning to success</span></li><li><span class="check">3</span><span>Real stories from Europe, USA, Australia…</span></li><li><span class="check">4</span><span>Tips and resources for students and professionals</span></li><li><span class="check">5</span><span>Visa, flight, and first challenges explained</span></li></ul><a class="btn btn-secondary" style="margin-top:24px" href="/guidance/">Find the book</a></div><div><h2 style="font-size:clamp(2.4rem,5vw,4.4rem);margin:0 0 26px">Free training + lab to help you</h2><div class="training-grid">{training.map((item,i)=><div class="training-item"><b>{i+1}</b><span>{item}</span></div>)}</div><a class="btn btn-primary" style="margin-top:24px" href="/free-training/">Click here for more</a></div></div></section>

  <section class="section white"><div class="container"><div class="cards"><article class="card"><div class="icon">✓</div><h3>Global Career success</h3><p>1. After training work with us<br/>2. Global skills development with latest tech, management<br/>3. Freelancing, startup, research and job abroad</p><a class="text-link" href="/success/">Read More →</a></article><article class="card"><div class="icon">▶</div><h3>Join Webiner</h3><p>Job, higher education, research, skills, learn from others Success story.</p><a class="text-link" href="/guidance/">Join Webiner →</a></article><article class="card"><div class="icon">1:1</div><h3>Free Personal Consultation</h3><p><strong>Study, Job, Freelancing, Startup, Research globally</strong><br/>Which country, University, degree<br/><br/><strong>15-30 mins free and open discussion</strong><br/>What goal, action and challange<br/><br/><strong>With practical experience</strong><br/>in IT, university and others</p><a class="text-link" href="/contact/">Contact us →</a></article></div></div></section>

  <section class="section"><div class="container cta"><div><h2>Wish to know more? Subscribe now!</h2></div><form class="cta-actions" action="/newsletter/" method="get"><input aria-label="Email" name="email" type="email" placeholder="Email" style="min-height:48px;border:0;border-radius:14px;padding:0 16px;min-width:260px"/><button class="btn btn-primary" type="submit">Subscribe</button></form></div></section>
</Layout>
