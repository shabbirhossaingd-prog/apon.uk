---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const training = ['English and IELTS','WordPress and SEO','App Development','Freelancing Programme','PhD & Research Training','Cloud Computing','AWS AI/ML certification','Startup Entrepreneur Training','Accounting (ACCA/CA)','Digital Marketing & Social Media Management'];
---
<Layout title="Apon UK: Global Platform with App and AI" description="Career, Asset Management, R&D Consultancy. Study, Freelancing, Job, Startup and Research degree globally.">
  <section class="hero hero-v2">
    <div class="container hero-grid-v2">
      <div class="hero-copy-block">
        <span class="eyebrow"><span class="eyebrow-dot"></span>About Apon UK</span>
        <h1>Making a <em>global career</em></h1>
        <div class="hero-copy">
          <p><strong>Study, Freelancing, Job, Startup, Research degree globally</strong></p>
          <p>Upload your details, start free training, work with us</p>
          <p>Personal mentoring, forum, development support</p>
        </div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://portal.apon.uk/">Join Apon Career platform free</a>
          <a class="btn btn-outline" href="/about/">Read More</a>
        </div>
      </div>

      <div class="career-board career-photo-board" aria-label="Students building global careers">
        <img class="career-photo" src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fm=webp&fit=crop&w=1400&q=78" alt="Students studying together" loading="eager" fetchpriority="high" />
        <div class="career-photo-shade"></div>
        <div class="career-board-top">
          <span class="board-label">Set Goal, Learn & Earn</span>
          <span class="board-dot"></span>
        </div>
        <div class="career-pills">
          <span>Study</span><span>Job</span><span>Research</span><span>Startup</span><span>Freelancing</span>
        </div>
        <div class="board-note">
          <span>Study, Freelancing, Job, Startup, Research degree globally</span>
          <span class="board-arrow">↗</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-intro white textured-section">
    <div class="container">
      <div class="section-head editorial-head">
        <div>
          <span class="section-kicker">Set Goal, Learn & Earn</span>
          <h2>Set Goal, Learn & Earn</h2>
        </div>
        <p>Goal: Job , Study abroad, start a research degree, startup or freelancing.</p>
      </div>

      <div class="service-grid-v2">
        <a class="service-card-v2 service-card-featured" href="/opportunities/">
          <div class="service-number">01</div>
          <div class="service-icon icon-bubble"><Icon name="success" size={28} /></div>
          <h3>Work and earn success with Global experts</h3>
          <p>Work opportunities with learning support<br/>Freelancing, work experience,<br/>interns, global job with remote work</p>
          <span class="service-link">Read More <b>→</b></span>
        </a>
        <a class="service-card-v2" href="/success/">
          <div class="service-number">02</div><div class="service-icon icon-bubble"><Icon name="target" size={28} /></div><h3>Set Goal, Learn & Earn</h3><p>Goal: Job , Study abroad, start a research degree, startup or freelancing.</p><span class="service-link">Read More <b>→</b></span>
        </a>
        <a class="service-card-v2" href="/guidance/">
          <div class="service-number">03</div><div class="service-icon icon-bubble"><Icon name="guide" size={28} /></div><h3>Guidance Ebook, join seminar</h3><p>Goal? Job , Study abroad, start a research degree, start up or freelancing.</p><span class="service-link">Read More <b>→</b></span>
        </a>
        <a class="service-card-v2" href="/free-training/">
          <div class="service-number">04</div><div class="service-icon icon-bubble"><Icon name="training" size={28} /></div><h3>Free training</h3><p>Training with work experience<br/>Free, personalized with real world example</p><span class="service-link">Read More <b>→</b></span>
        </a>
        <a class="service-card-v2" href="/opportunities/">
          <div class="service-number">05</div><div class="service-icon icon-bubble"><Icon name="seminar" size={28} /></div><h3>Work and earn success with Global experts</h3><p>Work opportunities with learning support<br/>Freelancing, work experience,<br/>interns, global job with remote work</p><span class="service-link">Read More <b>→</b></span>
        </a>
        <a class="service-card-v2 service-card-dark" href="/about/">
          <div class="service-number">06</div><div class="service-icon icon-bubble"><Icon name="spark" size={28} /></div><h3>Web Portal, AI & App</h3><p>About Apon UK</p><span class="service-link">Click Here <b>→</b></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section about-band textured-dark">
    <div class="container about-band-grid">
      <div class="about-band-copy">
        <span class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span>About Apon UK</span>
        <h2>Apon (someone very close, trustable) is a platform for global success.</h2>
        <p>20+ years of experience in Europe, far east and America. Follow us.</p>
        <div class="hero-actions"><a class="btn btn-light" href="/about/">Click Here</a><a class="btn btn-primary" href="/contact/">Contact us</a></div>
      </div>

      <div class="seminar-card seminar-card-photo">
        <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fm=webp&fit=crop&w=1200&q=78" alt="Students in a learning seminar" loading="lazy" />
        <div class="seminar-photo-overlay"></div>
        <div class="seminar-content">
          <span class="section-kicker section-kicker-light">Guideline Seminar</span>
          <div class="seminar-list">
            <div><span class="seminar-icon"><Icon name="seminar" size={22} /></span><p>Seminars on 3 areas: Overview, Global Study, Global Careers and Beyond</p></div>
            <div><span class="seminar-icon"><Icon name="study" size={22} /></span><p>Know more about higher study, research, job, scholarship, living expense</p></div>
            <div><span class="seminar-icon"><Icon name="calendar" size={22} /></span><p>For next seminar Register online</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section white glance-section textured-section">
    <div class="container">
      <div class="section-head editorial-head"><div><span class="section-kicker">Apon UK at a Glance</span><h2>Apon UK at a Glance</h2></div></div>
      <div class="stat-strip-v2">
        <div class="stat-v2">
          <span class="stat-icon"><Icon name="calendar" size={24} /></span>
          <span class="stat-label">Established</span>
          <strong class="stat-number" data-count="2014">0</strong>
        </div>
        <div class="stat-v2">
          <span class="stat-icon"><Icon name="globe" size={24} /></span>
          <span class="stat-label">Countries</span>
          <strong class="stat-number" data-count="5" data-suffix="+">0</strong>
        </div>
        <div class="stat-v2">
          <span class="stat-icon"><Icon name="location" size={24} /></span>
          <span class="stat-label">Location</span>
          <strong class="stat-number" data-count="2" data-suffix="+">0</strong>
        </div>
        <div class="stat-v2 stat-action"><a href="/contact/"><span>Contact us</span><b>↗</b></a></div>
      </div>
      <div class="glance-action"><a class="btn btn-primary" href="https://wa.me/447459157276">Join our WhatsApp community</a></div>
    </div>
  </section>

  <section class="section learning-section textured-soft">
    <div class="container learning-grid">
      <div class="ebook-panel-v2 ebook-photo-panel">
        <img src="https://images.unsplash.com/photo-1513258496099-48168024aec0?auto=format&fm=webp&fit=crop&w=1100&q=78" alt="Student learning with study materials" loading="lazy" />
        <div class="ebook-photo-shade"></div>
        <div class="ebook-content">
          <span class="section-kicker section-kicker-light">Career guidance Ebook</span>
          <h2>Career guidance Ebook</h2>
          <ol>
            <li><span>1</span>Complete guide to a global career</li>
            <li><span>2</span>Covers 10 key steps, planning to success</li>
            <li><span>3</span>Real stories from Europe, USA, Australia…</li>
            <li><span>4</span>Tips and resources for students and professionals</li>
            <li><span>5</span>Visa, flight, and first challenges explained</li>
          </ol>
          <a class="btn btn-light" href="/guidance/">Find the book</a>
        </div>
      </div>

      <div class="training-panel-v2">
        <span class="section-kicker">Free training + lab to help you</span>
        <h2>Free training + lab to help you</h2>
        <div class="training-list-v2">{training.map((item,i)=><a href="/free-training/"><span>{String(i+1).padStart(2,'0')}</span><strong>{item}</strong><b>↗</b></a>)}</div>
        <a class="btn btn-primary" href="/free-training/">Click here for more</a>
      </div>
    </div>
  </section>

  <section class="section white outcomes-section textured-section">
    <div class="container outcomes-grid">
      <article class="outcome-card outcome-primary"><span class="outcome-icon icon-bubble"><Icon name="success" size={26} /></span><h3>Global Career success</h3><p>1. After training work with us<br/>2. Global skills development with latest tech, management<br/>3. Freelancing, startup, research and job abroad</p><a href="/success/">Read More →</a></article>
      <article class="outcome-card"><span class="outcome-icon icon-bubble"><Icon name="play" size={26} /></span><h3>Join Webiner</h3><p>Job, higher education, research, skills, learn from others Success story.</p><a href="/guidance/">Join Webiner →</a></article>
      <article class="outcome-card"><span class="outcome-icon icon-bubble"><Icon name="chat" size={26} /></span><h3>Free Personal Consultation</h3><p><strong>Study, Job, Freelancing, Startup, Research globally</strong><br/>Which country, University, degree<br/><br/><strong>15-30 mins free and open discussion</strong><br/>What goal, action and challange<br/><br/><strong>With practical experience</strong><br/>in IT, university and others</p><a href="/contact/">Contact us →</a></article>
    </div>
  </section>

  <section class="section subscribe-section">
    <div class="container subscribe-card-v2">
      <div><span class="section-kicker section-kicker-light">Newsletter</span><h2>Wish to know more? Subscribe now!</h2></div>
      <form class="subscribe-form" action="/newsletter/" method="get"><input aria-label="Email" name="email" type="email" placeholder="Email" /><button class="btn btn-primary" type="submit">Subscribe</button></form>
    </div>
  </section>
</Layout>
