---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Layout title="Download App | Apon UK" description="The Apon app is designed for students, parents, and professionals, providing resources on education, student visas, and career paths.">
  <PageHeader title="Download App" subtitle="The Apon app is designed for students, parents, and professionals, providing resources on education, student visas, and career paths." />
  <section class="section">
    <div class="container app-panel">
      <div>
        <span class="eyebrow"><span class="eyebrow-dot"></span>Apon Career</span>
        <h2 style="font-size:clamp(2.5rem,5vw,4.7rem);margin:18px 0 20px">Web Portal, AI & App</h2>
        <div class="pill-list"><span class="pill">Study</span><span class="pill">Student visas</span><span class="pill">Career paths</span></div>
        <div class="hero-actions"><a class="btn btn-primary" href="https://play.google.com/store/apps/details?id=uk.apon.career">Google Play</a><a class="btn btn-light" href="https://portal.apon.uk/">Apon Portal</a></div>
      </div>
      <div class="phone-visual" aria-hidden="true"></div>
    </div>
  </section>
</Layout>
