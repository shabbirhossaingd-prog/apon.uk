---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
const posts=[
  {title:'PhD: guidance and training',href:'/researchdegree/',image:'https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=1000&q=84'},
  {title:'Free training, work for freelancer',href:'/freelancing/',image:'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1000&q=84'},
  {title:'Freelance Immigration, Travel, and Study Visa Consultant',href:'/opportunities/',image:'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1000&q=84'},
  {title:'Freelance Software Testing and Quality ...',href:'/opportunities/',image:'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1000&q=84'}
];
---
<Layout title="Opportunities | Apon UK" description="Apon UK opportunities category." schemaType="CollectionPage">
  <div class="edu-archive-page">
    <PageHeader eyebrow="Category" title="Opportunities" subtitle="" />
    <section class="edu-archive-section">
      <div class="container edu-archive-grid">
        {posts.map((post,index)=><article class="edu-archive-card">
          <a class="edu-archive-media" href={post.href} aria-label={post.title}>
            <img src={post.image} alt="" loading={index<2?'eager':'lazy'} decoding="async" />
            <span>↗</span>
          </a>
          <div class="edu-archive-body">
            <span class="edu-archive-meta">Opportunities</span>
            <h2><a href={post.href}>{post.title}</a></h2>
            <a class="edu-archive-link" href={post.href}>Read More <b>→</b></a>
          </div>
        </article>)}
      </div>
    </section>
  </div>
</Layout>

<style is:global>
.edu-archive-page .subpage-hero{padding:124px 0 64px!important;background:#eef4fb!important;color:#10233f!important}
.edu-archive-page .subpage-hero-grid{min-height:300px!important;grid-template-columns:1fr .62fr!important;gap:54px!important}
.edu-archive-page .subpage-hero h1{color:#082b61!important;font-size:clamp(4rem,8vw,7.2rem)!important;line-height:.86!important;letter-spacing:-.075em!important}
.edu-archive-page .subpage-hero .eyebrow{background:#fff!important;color:#1557b7!important;border:1px solid rgba(21,87,183,.1)!important}
.edu-archive-page .subpage-hero-media{height:300px!important;border-radius:30px!important;box-shadow:none!important;transform:none!important}
.edu-archive-page .subpage-hero-media:after,.edu-archive-page .media-ring,.edu-archive-page .media-brand{display:none!important}
.edu-archive-section{padding:92px 0 120px;background:#fff}
.edu-archive-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 28px}
.edu-archive-media{position:relative;display:block;aspect-ratio:1.62/1;overflow:hidden;border-radius:22px;background:#e9eef5}
.edu-archive-media img{width:100%;height:100%;object-fit:cover;transition:transform .65s cubic-bezier(.2,.7,.2,1)}
.edu-archive-card:hover .edu-archive-media img{transform:scale(1.045)}
.edu-archive-media span{position:absolute;right:16px;top:16px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.94);color:#082b61;opacity:0;transform:translateY(-7px);transition:.28s ease}
.edu-archive-card:hover .edu-archive-media span{opacity:1;transform:none}
.edu-archive-body{padding:20px 2px 0}
.edu-archive-meta{display:inline-flex;align-items:center;gap:8px;color:#1557b7;font-size:.68rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
.edu-archive-meta:before{content:"";width:22px;height:2px;background:#ff823d}
.edu-archive-body h2{margin:13px 0 18px;font-size:clamp(1.7rem,2.8vw,2.7rem)!important;line-height:1!important;letter-spacing:-.05em!important}
.edu-archive-body h2 a{color:#10233f}
.edu-archive-link{display:inline-flex;gap:10px;align-items:center;color:#082b61;font-size:.82rem;font-weight:850}.edu-archive-link b{transition:transform .2s ease}.edu-archive-link:hover b{transform:translateX(5px)}
@media(max-width:900px){.edu-archive-page .subpage-hero-grid{grid-template-columns:1fr!important}.edu-archive-page .subpage-hero-media{display:none}.edu-archive-grid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.edu-archive-page .subpage-hero{padding:104px 0 48px!important}.edu-archive-page .subpage-hero-grid{min-height:auto!important}.edu-archive-page .subpage-hero h1{font-size:clamp(3.35rem,17vw,5.1rem)!important}.edu-archive-section{padding:58px 0 80px}.edu-archive-grid{grid-template-columns:1fr;gap:34px}.edu-archive-media span{opacity:1;transform:none}}
</style>
