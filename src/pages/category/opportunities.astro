---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
const posts=[
  {title:'PhD: guidance and training',href:'/researchdegree/'},
  {title:'Free training, work for freelancer',href:'/freelancing/'},
  {title:'Freelance Immigration, Travel, and Study Visa Consultant',href:'/opportunities/'},
  {title:'Freelance Software Testing and Quality ...',href:'/opportunities/'}
];
---
<Layout title="Opportunities | Apon UK" description="Apon UK opportunities category." schemaType="CollectionPage">
  <PageHeader eyebrow="Category" title="Opportunities" subtitle="" />
  <section class="section white">
    <div class="container archive-grid">
      {posts.map((post)=><article class="archive-card"><span class="archive-meta">Opportunities</span><h3>{post.title}</h3><a class="text-link" href={post.href}>Read More →</a></article>)}
    </div>
  </section>
</Layout>
