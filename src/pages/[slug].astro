---
import Layout from '../layouts/Layout.astro';

const pages = {
  startup: {
    title:'Startup development', subtitle:'Ideation, Training & funding Support',
    sections:[
      ['🧰 Key Features',`<ul><li><strong>Free Business Tools:</strong> Access to downloadable templates, business plan builders, and startup checklists.</li><li><strong>Mentoring, guidance ebook:</strong> Opportunities to connect with experienced mentors and industry professionals</li><li><strong>Workshops & Events:</strong> Regular online and in-person events to network, learn, and grow.</li><li><strong>Funding Support:</strong> Guidance on applying for UK government-backed Start Up Loans and other funding options.</li><li><strong>Community Access:</strong> Join a network of like-minded entrepreneurs for collaboration and peer support.</li></ul><p>For Global market. Start development of your idea. Market growth, funding, capitalization and global growth are available with our startup model.</p>`],
      ['💡 Who It’s For',`<p>First-time founders looking for step-by-step guidance<br/>Side hustlers ready to go full-time<br/>Anyone with a business idea needing structure, support, and resources</p>`],
      ['Startup Training',`<p>Hands-on workshops in design thinking, prototyping, user testing and lean validation—completely free. Through bite-sized videos, live clinics and downloadable toolkits, you’ll learn how to iterate quickly, build a minimum viable product (MVP), and attract your first users, investor. Also learn business, communication and global mobility fundamental. Details on learning</p><p><a class="btn btn-primary" href="/free-training/">Free Training</a></p>`],
      ['End-to-End Mentorship & Funding support',`<p><a href="/contact/">Contact us</a><br/><a href="https://wa.me/447459157276">Join our WhatsApp community</a></p><p>Our seasoned entrepreneurs and investors guide you from day one through launch. You’ll receive:</p><ul><li><strong>1:1 Coaching:</strong> Tailored business planning, pitch crafting, and growth strategies.</li><li><strong>Peer Circles:</strong> Monthly mastermind sessions with fellow founders.</li><li><strong>Seed Capital Access:</strong> Introductions to angel networks and early-stage VCs, plus help preparing pitch decks and term sheets</li></ul><p>Contact us for Startup Goal focussed training and mentorship</p><p>Beyond seed funding, Apon connects you with:</p><p><strong>Alumni Network:</strong> A community of startups, mentors, and service-providers ready to help you scale</p><p><strong>Grants & Competitions:</strong> Curated listings of non-dilutive funding opportunities.</p><p><strong>Incubator Partnerships:</strong> Access to coworking space, legal clinics, and tech infrastructure.</p>`],
      ['Financial Support & Growth',`<p>See our startup steps and plan.</p><p>BD startup-capitalization-global-BDSG.pptxDownload</p>`],
      ['Join existing startup',`<p>Contact us</p><p>Join in our existing startup projects below as a partner or share your ideas</p><ul><li>Asset Management: AI driven Startup for global real estate solutions</li><li>Electronics/IoT: AI and IoT driven Startup for smart electronic solutions</li></ul><p><a href="https://wa.me/447459157276">Join our WhatsApp community</a></p><p>Click Here</p>`],
      ['Try other goals',`<p>Research scholarship degrees: MS, PhD<br/>Job in Europe, America..<br/>Freelancing<br/>Entrepreneurship and Start up<br/>Study abroad.</p>`]
    ]
  },
  researchdegree:{title:'Research degree',subtitle:'Scholarship, preparation, training, mentoring',sections:[
    ['',`<p><a class="btn btn-primary" href="/contact/">Join 1 on 1 Session</a></p><p>Start your academic journey with confidence through Apon’s comprehensive support system. From skill-building workshops to expert supervision and tailored funding guidance, we provide everything you need to succeed. Whether you’re preparing a research proposal, seeking the right mentor, or exploring future career paths, Apon is here to guide you every step of the way. Our resources are designed to help you thrive both during your degree and beyond. With Apon, you’re never on this journey alone.</p>`],
    ['Research Training',`<p>Kickstart Your Academic Success with Apon’s Expert Workshops and Modules</p><ol><li>Expert-led workshops designed to strengthen your academic foundation</li><li>Learn essential skills including research design, academic writing, and data analysis</li><li>Gain a solid understanding of both qualitative and quantitative research methods</li><li>Develop critical thinking and analytical abilities</li><li>Participate in interactive webinars for hands-on learning</li><li>Access practical guides to support every step of your research process</li><li>Build a clear and effective research proposal with confidence</li></ol>`],
    ['Supervisory Network & Resources',`<ol><li>Connect with expert supervisors aligned with your research interests</li><li>Access university labs, libraries, and collaborative workspaces</li><li>Support for scheduling advisor meetings and lab visits</li><li>Join and organize peer study groups for shared learning</li><li>Structured guidance to help turn your research ideas into real impact</li><li>Create a productive academic environment from day one</li></ol>`],
    ['Funding & Career Pathways',`<ol><li>Find scholarships, grants, and stipends tailored to your field and location</li><li>Explore part-time opportunities like research and teaching assistantships</li><li>Learn about fellowships and industry partnership programs</li><li>Get support navigating financial planning during your studies</li><li>Attend career guidance sessions focused on post-degree planning</li><li>Prepare for diverse career paths in academia or industry</li></ol><p><a href="/contact/">Contact us</a><br/><a href="https://wa.me/447459157276">Join our WhatsApp community</a></p><p>Join in our existing Research projects below as a partner or share your ideas</p><ul><li>Asset Management: AI driven Startup for global real estate solutions</li><li>Electronics/IoT: AI and IoT driven Startup for smart electronic solutions</li></ul>`]
  ]},
  jobabroad:{title:'Job abroad',subtitle:'Work opportunity, career development, mentoring',sections:[
    ['',`<ul><li>International job focussed, business and communications training</li><li>Mentoring, guidance ebook, business fundamentals training for global career</li><li>Product incubation, financial support</li></ul>`],
    ['Start career abroad',`<p>Unlock global opportunities with Apon’s Job Abroad support program. We guide you through securing jobs, building in-demand skills, and preparing for international careers.<br/>Expert-led training and career mentorship job placement, Our tailored resources make the journey smoother.</p>`],
    ['Career Training',`<ol><li>Access top scholarships based on merit, destination country, or field of study</li><li>Eliminate financial stress so you can focus on learning</li><li>Free training programs in IELTS, digital marketing, coding, and more</li><li>Skill-building courses designed to meet international job market demands</li><li>Boost your global employability before you even leave home</li></ol><p><a class="btn btn-primary" href="/free-training/">Free Training</a></p>`],
    ['End-to-End Mentorship & Career Guidance',`<p>Read More</p><ul><li>Personalized action plans based on your background and career goals</li><li>Assistance in finding part-time jobs, internships, and assistantships</li><li>Support for student-friendly loans, income-share agreements, and on-campus work</li><li>Career prep: mock interviews, CV/resume reviews, and offer negotiation</li><li>Full guidance through job search, visa process, and relocation abroad</li></ul><p><a href="/contact/">Contact us</a></p><ul><li>Register through Apon Portal for access to financial support and study loan options</li><li>Explore job placement opportunities through Apon’s informal global network</li><li>Special support for candidates with skills like driving or cooking</li><li>No false promises—just real connections and honest support</li><li>Designed to ease your transition from education to employment abroad</li></ul>`],
    ['Career development Support & Job Placement',`<p><a href="https://wa.me/447459157276">Join our WhatsApp community</a></p><p>Apply in our existing projects or join in seminar.</p><ul><li>Asset Management: AI driven Startup for global real estate solutions</li><li>Electronics/IoT: AI and IoT driven Startup for smart electronic solutions</li></ul>`]
  ]},
  guidance:{title:'Our Guidance and Free Seminar',subtitle:'',sections:[
    ['Ebook',`<p>Buy from Apon Portal</p><p><a class="btn btn-primary" href="https://portal.apon.uk/">Buy Book</a></p>`],
    ['Preparation',`<p>Admission preparation, global minimum skills, language proficiency, travel arrangements, minimum income skills, admission application, country, institution, field of study, decision-making, and experience.</p><p>Read More</p>`],
    ['Selection Admission',`<p>Visa, travel, early education and life abroad, degree attainment, early career, success, law, religion, society, community, politics, and experience.</p><p><a class="btn btn-primary" href="/contact/">Join Free Seminar</a></p>`],
    ['Why',`<ul><li>Guidance with practical experience</li><li>Exercise and training</li><li>Order online, read from your device</li><li>Training and work experience</li></ul><p><a class="btn btn-primary" href="/contact/">Join Free Seminar</a></p>`],
    ['Preparation',`<ol><li>Preparing to study abroad takes careful planning. First, students need to secure admission to a University and handle their visa applications. It’s also important to build key skills, like learning the language and becoming more adaptable to new environments.</li><li>Understanding how to live and study in a new country helps students adjust more easily. This includes arranging travel, budgeting finances, and learning about the country’s education system and culture.</li><li>With the right preparation, students can settle in smoothly and make the most of their study abroad experience. It’s a strong start to a successful journey.</li></ol><p>Register for a free Seminar or personal training</p>`],
    ['Selection and Admission',`<p>First of all select your chosen country and course. Understand the requirements of the particular course and have a guideline about it some basic fundamentals about it. Select Your Chosen university and apply on your selected program.</p><p>Register for a free Seminar or personal training</p>`],
    ['Job & Career Success',`<p>We have experienced professionals who help train our students in various art forms such as dance, drama, and painting. To support their growth, we regularly organize exhibitions, concerts, and music events. These platforms allow our students to showcase their talents and build confidence in their creative journey.</p><p>Register for a free Seminar or personal training</p>`]
  ]},
  'financial-support-by-apon':{title:'Financial Support by Apon',subtitle:'',sections:[
    ['',`<p>At Apon, we believe finances should never be a barrier to personal or professional growth. That’s why we offer multiple financial support options—whether you’re enrolling in training, planning to study abroad, or building your career. We partner with trusted institutions to make the process smooth, secure, and student-friendly</p>`],
    ['Training Program Support:',`<p>We offer partial or full financial assistance for selected training programs available through Apon. This includes digital skills, freelancing, language preparation (like IELTS), and career-specific certifications. Our goal is to ensure you can access the learning you need—regardless of your financial background</p>`],
    ['Student Loan Assistance',`<p>For those planning to pursue higher education locally or abroad, we help facilitate student loans through our verified partner banks</p><p><strong>How the Process Works:</strong></p><ol><li><strong>Register & Login</strong><br/>Sign up on the Apon Portal and log in to your dashboard.</li><li><strong>Submit Documents</strong><br/>Upload all required documents—these must be original, authentic, and verifiable.</li><li><strong>We Forward to Partner Bank</strong><br/>Our team will review your submission and send it to the relevant partner bank.</li><li><strong>Bank Will Respond</strong><br/>The bank will provide a checklist of any additional documents or steps needed.</li><li><strong>Proceed with Application</strong><br/>Once verified, you’ll continue with the official student loan process guided by the bank.</li></ol><p><strong>Important Notes:</strong></p><ul><li>All documents must be real, valid, and issued by recognized authorities</li><li>Any attempt to submit false or altered documents will result in disqualification</li><li>Loan approval depends on your academic plan, financial need, and the bank’s internal review</li></ul>`]
  ]},
  acp:{title:'Apon Pioneers 1.0',subtitle:'',sections:[
    ['',`<p>Apon Pioneers 1.0 is the official Campus Ambassador Recruitment Program of Apon.uk, a global career platform dedicated to study abroad with scholarship and funding opportunities, freelancing, startup development, Research Degree and Job Overseas.<br/>We believe student ambassadors play a vital role in bridging the gap between campuses and our mission. As Apon Pioneers, you will help us reach our goals while building valuable skills and networks for yourself.</p>`],
    ['Eligibility',`<ul><li>Open to students from any college or university.</li><li>Must be currently enrolled in HSC, Honours, Alim, or A-Levels.</li><li>Commitment: 4 months.</li><li>Involvement with any clubs or organizations</li><li>Weekly 10-14 hours of Work</li></ul>`],
    ['Responsibilities of Apon Pioneers',`<ul><li>Promote Apon.uk activities within their campus.</li><li>Serve as the bridge between your institution (students, faculty and clubs) and Apon.uk.</li><li>Share branding materials (posters, leaflets, digital content) across their campus.</li><li>Help in making MoU‘s with clubs and organization in your own campus</li></ul>`],
    ['Benefits for Apon Pioneers',`<ul><li>Completion certificate recognizing your contribution.</li><li>Paid internships opportunities to our different departments such as IT, Business, when vacancies are available</li><li>Free access to all premium courses offered by Apon.uk.</li><li>A chance to expand professional network and develop leadership skills.</li><li>Commission on each referral to our paid workshops, sessions</li><li>Guidance and mentorship session from the experienced faculty, professionals etc</li></ul>`],
    ['Performance Evaluation',`<p>Submission of a monthly activity report detailing completed tasks.</p>`],
    ['Registration is Open Now',`<p>Registration form link: <a href="https://forms.gle/tiFAfowZx3XGzU7S6">https://forms.gle/tiFAfowZx3XGzU7S6</a></p>`],
    ['Deadline of Registration',`<p>October 10, 2025</p>`],
    ['For Further Queries',`<p>Reach us at: info@apon.uk</p>`]
  ]},
  about:{title:'About Apon UK',subtitle:'Apon dot UK',sections:[
    ['',`<p>A global career & technology service provider</p><p>All service details</p><p>Global career platform, support and consultancy</p><p>R&D, Consultancy</p><p>Outsourcing</p><p>Asset Management platform, support and consultancy</p><p>20+ years of our journey</p><p><a class="btn btn-primary" href="/contact/">Contact us</a></p>`],
    ['Apon Team & Mentors',`<p>Our passionate and dedicated global team brings together a diverse range of skills and expertise to deliver exceptional results. From creative visionaries to meticulous strategists, we work seamlessly together to meet and exceed our clients’ expectations.</p><h3>Monir Bhuiyan PhD</h3><p>Dr. Moniruzzaman Bhuiyan, founder of Apon.uk, is an IT expert and researcher, Lead Software Architect, for Corporate and Investment Banking of a leading British Bank. He is a founder of Global NRB organization, based in USA. He is also founder multiple projects, groups and initiatives in Bangladesh and worldwide. He leads organization, teams, innovation, software solution architecture, design, tech transformation and Fintech regulatory requirement. He has 25+ years of experience with the sector globally.</p><p>He has achieved PhD degree from University of Wales, UK under UK govt. scholarship and Post-doctoral fellowship from University of Northumbria, UK. He is an ex faculty of IIT, Dhaka University, also worked for two UK universities before moving to Fintech R&D. He started his career as technology reporter and writer in 1996 and in 1999, started software engineering role for a Amsterdam based Fintech.</p><p>Dr. Bhuiyan’s specializations are in future technology, AI, global education and career, counselling, software & data architecture, Cloud, FinTech. He worked as consultant, expert and researcher for Bangladesh Bank, JAICA, Internet Society, Dutch and international companies.</p><p>He is a public speaker, an author/editor of many popular technology articles, peer reviewed publications and books; has regularly contributed for national dailies and magazines since 1996. He is a Microsoft Certified Professional (MCP) and PRINCE2 practitioner. He is a professional member of British Computer Society. He is also involved in voluntary Athletics coaching with England Athletics, loves cycling and boating.</p>`],
    ['Global Partnership',`<h3>Miraj Uddin PhD (USA)</h3><p>North America</p><p>Global Business Partner</p><h3>Coming soon</h3><p>KSA/UAE/GCC</p>`],
    ['Our Mentors',`<h3>Jahidul Hasan</h3><p>Team lead and Programmer</p><h3>Kayes Azad</h3><p>Business Administration</p><h3>Muntasir Ahsan</h3><p>Business Development Executive</p><h3>Abdullah Al Noman Shompod</h3><p>Research Associate, Apon Research Hub</p><p>Research hub align with organizational R&D.Industry and government to secure joint research funding.</p>`]
  ]},
  contact:{title:'Contact',subtitle:'',sections:[['',`<p>10, PINELEA ALTRINCHAM WA15 8WG United Kingdom</p><p>+44 7459 157276</p><p>info@apon.uk</p><form style="display:grid;gap:14px;max-width:620px;margin-top:28px"><input placeholder="First Name" style="padding:14px;border:1px solid var(--line);border-radius:12px"/><input type="email" placeholder="Email Address" style="padding:14px;border:1px solid var(--line);border-radius:12px"/><input placeholder="Phone" style="padding:14px;border:1px solid var(--line);border-radius:12px"/><button class="btn btn-primary" type="button">Send Message</button></form>`]]},
  'free-training':{title:'Free training',subtitle:'Training with work experience',sections:[['',`<p>Free, personalized with real world example</p><ul><li>English and IELTS</li><li>WordPress and SEO</li><li>App Development</li><li>Freelancing Programme</li><li>PhD & Research Training</li><li>Cloud Computing</li><li>AWS AI/ML certification</li><li>Startup Entrepreneur Training</li><li>Accounting (ACCA/CA)</li><li>Digital Marketing & Social Media Management</li></ul>`]]},
  opportunities:{title:'Opportunities',subtitle:'',sections:[['',`<p>Work opportunities with learning support<br/>Freelancing, work experience,<br/>interns, global job with remote work</p>`]]},
  success:{title:'Global Career success',subtitle:'',sections:[['',`<ol><li>After training work with us</li><li>Global skills development with latest tech, management</li><li>Freelancing, startup, research and job abroad</li></ol>`]]},
  studyabroad:{title:'Study Abroad',subtitle:'',sections:[['',`<p>Study, Freelancing, Job, Startup, Research degree globally</p><p>Upload your details, start free training, work with us</p><p>Personal mentoring, forum, development support</p><p><a class="btn btn-primary" href="https://portal.apon.uk/">Join Apon Career platform free</a></p>`]]},
  freelancing:{title:'Freelancing',subtitle:'',sections:[['',`<p>Work opportunities with learning support<br/>Freelancing, work experience,<br/>interns, global job with remote work</p>`]]},
  newsletter:{title:'Newsletter',subtitle:'Wish to know more? Subscribe now!',sections:[['',`<form style="display:flex;gap:10px;flex-wrap:wrap"><input type="email" placeholder="Email" style="padding:14px;border:1px solid var(--line);border-radius:12px;min-width:280px"/><button class="btn btn-primary" type="button">Subscribe</button></form>`]]},
  'downoad-app':{title:'Download App',subtitle:'',sections:[['',`<p>The Apon app is designed for students, parents, and professionals, providing resources on education, student visas, and career paths.</p>`]]},
  payments:{title:'Payment',subtitle:'',sections:[['',`<p>Payment</p><p><a class="btn btn-primary" href="/contact/">Contact us</a></p>`]]}
};

export function getStaticPaths(){return Object.entries(pages).map(([slug,page])=>({params:{slug},props:{page}}));}
const {page}=Astro.props;
---
<Layout title={`${page.title} – Apon UK`} description={page.subtitle || page.title}>
  <section class="page-hero"><div class="container"><span class="eyebrow"><span class="eyebrow-dot"></span>Apon UK</span><h1>{page.title}</h1>{page.subtitle && <p class="hero-copy">{page.subtitle}</p>}</div></section>
  <section class="section white"><article class="container prose">{page.sections.map(([heading,body])=><section>{heading && <h2>{heading}</h2>}<div set:html={body}></div></section>)}</article></section>
</Layout>
