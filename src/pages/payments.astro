---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Layout title="Payment | Apon UK" description="Apon UK payment information.">
  <PageHeader title="Payment" subtitle="" />
  <section class="section white">
    <div class="container" style="max-width:850px">
      <div class="info-panel">
        <span class="eyebrow"><span class="eyebrow-dot"></span>Payment</span>
        <h2 style="margin:18px 0">Bank Transfer (Euro/Dollar/Pound/Cheque)</h2>
        <p>Make your payment directly into our bank account. Please use your Order ID as the payment reference.</p>
        <div class="hero-actions"><a class="btn btn-primary" href="/contact/">Contact us</a></div>
      </div>
    </div>
  </section>
</Layout>
