---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
const items=[
  {title:'PhD: guidance and training',category:'Opportunities',href:'/researchdegree/',image:'https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=1200&q=84'},
  {title:'Free training, work for freelancer',category:'Opportunities',href:'/freelancing/',image:'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1000&q=84'},
  {title:'Freelance Immigration, Travel, and Study Visa Consultant',category:'Opportunities',href:'/opportunities/',image:'https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1000&q=84'},
  {title:'Freelance Software Testing and Quality ...',category:'Opportunities',href:'/opportunities/',image:'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1000&q=84'}
];
---
<Layout title="Blogs | Apon UK" description="Apon UK blogs and opportunities." schemaType="CollectionPage">
  <div class="edu-blog-page">
    <PageHeader eyebrow="Apon UK" title="Blogs" subtitle="" />

    <section class="edu-blog-section">
      <div class="container edu-blog-grid">
        {items.map((item,index)=><article class:list={["edu-blog-card", index===0 && "edu-blog-featured"]}>
          <a class="edu-blog-media" href={item.href} aria-label={item.title}>
            <img src={item.image} alt="" loading={index===0?'eager':'lazy'} decoding="async" />
            <span class="edu-blog-arrow">↗</span>
          </a>
          <div class="edu-blog-body">
            <span class="edu-blog-meta">{item.category}</span>
            <h2><a href={item.href}>{item.title}</a></h2>
            <a class="edu-blog-link" href={item.href}>Read More <span>→</span></a>
          </div>
        </article>)}

        <aside class="edu-blog-subscribe">
          <span class="edu-blog-meta">Newsletter</span>
          <h2>Wish to know more? Subscribe now!</h2>
          <form action="/newsletter/" method="get">
            <input aria-label="Email" name="email" type="email" placeholder="Email" />
            <button class="btn btn-primary" type="submit">Subscribe</button>
          </form>
        </aside>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
.edu-blog-page .subpage-hero{padding:124px 0 64px!important;background:#eef4fb!important;color:#10233f!important}
.edu-blog-page .subpage-hero-grid{min-height:300px!important;grid-template-columns:1fr .62fr!important;gap:54px!important}
.edu-blog-page .subpage-hero h1{color:#082b61!important;font-size:clamp(4rem,8vw,7.5rem)!important;line-height:.86!important;letter-spacing:-.075em!important}
.edu-blog-page .subpage-hero .eyebrow{background:#fff!important;color:#1557b7!important;border:1px solid rgba(21,87,183,.10)!important}
.edu-blog-page .subpage-hero-media{height:300px!important;border-radius:30px!important;box-shadow:none!important;transform:none!important}
.edu-blog-page .subpage-hero-media:after,.edu-blog-page .media-ring,.edu-blog-page .media-brand{display:none!important}
.edu-blog-section{padding:92px 0 120px;background:#fff}
.edu-blog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;align-items:start}
.edu-blog-card{min-width:0}
.edu-blog-featured{grid-column:span 2}
.edu-blog-media{position:relative;display:block;aspect-ratio:1.32/1;overflow:hidden;border-radius:22px;background:#e9eef5}
.edu-blog-featured .edu-blog-media{aspect-ratio:1.85/1}
.edu-blog-media img{width:100%;height:100%;object-fit:cover;transition:transform .65s cubic-bezier(.2,.7,.2,1)}
.edu-blog-card:hover .edu-blog-media img{transform:scale(1.045)}
.edu-blog-arrow{position:absolute;right:16px;top:16px;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.94);color:#082b61;font-size:1.15rem;transform:translateY(-7px);opacity:0;transition:.3s ease}
.edu-blog-card:hover .edu-blog-arrow{opacity:1;transform:none}
.edu-blog-body{padding:22px 2px 12px}
.edu-blog-meta{display:inline-flex;align-items:center;gap:8px;color:#1557b7;font-size:.68rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
.edu-blog-meta:before{content:"";width:22px;height:2px;background:#ff823d}
.edu-blog-body h2{margin:13px 0 20px;font-size:clamp(1.55rem,2.4vw,2.35rem)!important;line-height:1.02!important;letter-spacing:-.045em!important}
.edu-blog-featured .edu-blog-body h2{font-size:clamp(2rem,3.5vw,3.4rem)!important;max-width:760px}
.edu-blog-body h2 a{color:#10233f}
.edu-blog-link{display:inline-flex;align-items:center;gap:10px;color:#082b61;font-size:.82rem;font-weight:850}
.edu-blog-link span{transition:transform .22s ease}
.edu-blog-link:hover span{transform:translateX(5px)}
.edu-blog-subscribe{min-height:100%;padding:30px;border-radius:24px;background:#082b61;color:#fff;display:flex;flex-direction:column;justify-content:flex-end}
.edu-blog-subscribe .edu-blog-meta{color:#fff}
.edu-blog-subscribe h2{margin:18px 0 28px;color:#fff;font-size:clamp(2rem,3vw,3rem)!important;line-height:.96!important;letter-spacing:-.05em!important}
.edu-blog-subscribe form{display:grid;gap:10px}
.edu-blog-subscribe input{min-height:52px;border:0;border-radius:999px;padding:0 18px;font:inherit;outline:0}
.edu-blog-subscribe .btn{width:100%}
@media(max-width:960px){.edu-blog-page .subpage-hero-grid{grid-template-columns:1fr!important}.edu-blog-page .subpage-hero-media{display:none}.edu-blog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.edu-blog-featured{grid-column:span 2}}
@media(max-width:640px){.edu-blog-page .subpage-hero{padding:104px 0 48px!important}.edu-blog-page .subpage-hero-grid{min-height:auto!important}.edu-blog-page .subpage-hero h1{font-size:clamp(3.5rem,18vw,5.4rem)!important}.edu-blog-section{padding:58px 0 80px}.edu-blog-grid{grid-template-columns:1fr;gap:34px}.edu-blog-featured{grid-column:auto}.edu-blog-featured .edu-blog-media,.edu-blog-media{aspect-ratio:1.35/1}.edu-blog-arrow{opacity:1;transform:none;width:40px;height:40px}.edu-blog-subscribe{min-height:330px}}
</style>
